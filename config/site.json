          "target": true
        },
        {
          "href": "https://foxterm.app/contact",
          "key": "footer.links.1.0",
          "rel": "noopener noreferrer",
          "sep": true,
          "target": true
        },
        {
          "href": "https://foxterm.app/privacy",
          "key": "footer.links.2.0",
          "rel": "noopener noreferrer",
          "sep": true,
          "target": true
        },
        {
          "href": "https://foxterm.app/terms",
